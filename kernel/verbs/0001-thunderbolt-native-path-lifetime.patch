+	/* Native service tuple is owned under tb->lock until exact cleanup.
+	 * native_dma_removed is release/acquire published after core cleanup. */
+	int native_tx_path[2], native_tx_ring[2], native_rx_path[2], native_rx_ring[2];
+	unsigned int native_dma_count;
+	bool native_dma_stopping;
+	bool native_dma_removed;
+#endif
 };
 
