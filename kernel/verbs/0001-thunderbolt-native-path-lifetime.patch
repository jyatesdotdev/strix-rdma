+
+#if IS_ENABLED(CONFIG_INFINIBAND_STRIX_NHI)
+/**
+ * tb_xdomain_try_enable_native_paths() - Nonblocking native DMA path admission
+ * @xd: XDomain (caller must keep its service alive)
+ * @transmit_path: Independently reserved output HopID
+ * @transmit_ring: Caller-owned TX ring HopID
+ * @receive_path: Independently reserved input HopID
+ * @receive_ring: Caller-owned RX ring HopID
+ *
+ * Software CM only, one native tuple per XDomain. -EAGAIN means tb->lock
+ * could not be acquired and NOTHING changed. -ENODEV rejects removal; other
+ * errors roll back activation. On success the caller must retain all four
+ * IDs/rings until try_disable returns 0 or -ENODEV. Existing path APIs keep
+ * their blocking semantics. No service work may wait for tb->lock on remove.
+ */
+int tb_xdomain_try_enable_native_paths(struct tb_xdomain *xd, int transmit_path,
+		int transmit_ring, int receive_path, int receive_ring)
+{
+	struct tb *tb = xd->tb;
+	int ret;
+
+	if (tb->cm_ops != &tb_cm_ops)
+		return -EOPNOTSUPP;
+	if (smp_load_acquire(&xd->native_dma_removed))
+		return -ENODEV;
+	if (!mutex_trylock(&tb->lock))
+		return -EAGAIN;
+	if (xd->native_dma_stopping || xd->native_dma_removed || xd->is_unplugged)
+		ret = -ENODEV;
+	else if (xd->native_dma_count == ARRAY_SIZE(xd->native_tx_path))
+		ret = -EBUSY;
+	else if (transmit_path < 8 || receive_path < 8 ||
+		 transmit_ring < 1 || receive_ring < 1)
+		ret = -EINVAL;
+	else {
+		ret = __tb_approve_xdomain_paths(tb, xd, transmit_path,
+				transmit_ring, receive_path, receive_ring);
+		if (!ret) {
+			unsigned int slot = xd->native_dma_count++;
+			xd->native_tx_path[slot] = transmit_path;
+			xd->native_tx_ring[slot] = transmit_ring;
+			xd->native_rx_path[slot] = receive_path;
+			xd->native_rx_ring[slot] = receive_ring;
+		}
 	}
+	mutex_unlock(&tb->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(tb_xdomain_try_enable_native_paths);
+
+static void tb_release_native_paths(struct tb_xdomain *xd)
+{
+	lockdep_assert_held(&xd->tb->lock);
+	/* Tuples cannot be reused: their service still owns both rings and both
+	 * HopID reservations each. Earlier core invalid-tunnel cleanup may already
+	 * have removed them; exact matching is then a safe no-op. */
+	while (xd->native_dma_count) {
+		unsigned int slot = --xd->native_dma_count;
+
+		__tb_disconnect_xdomain_paths(xd->tb, xd,
+			xd->native_tx_path[slot], xd->native_tx_ring[slot],
+			xd->native_rx_path[slot], xd->native_rx_ring[slot]);
+	}
+}
+
+/**
+ * tb_xdomain_try_disable_native_paths() - Release the admitted native tuple
+ * @xd: XDomain with a tuple admitted by try_enable_native_paths()
+ *
+ * Returns 0 after exact tuple cleanup, -ENODEV after the removing core has
+ * already completed cleanup, or -EAGAIN with ownership UNCHANGED. Never waits
+ * for tb->lock. A service removing outside core removal may retry in its own
+ * process context, without its worker/object lock held, until local release.
+ * Removal from under tb->lock observes native_dma_removed without taking it.
+ * DMA must be locally stopped/joined separately before freeing any memory.
+ */
+int tb_xdomain_try_disable_native_paths(struct tb_xdomain *xd)
+{
+	struct tb *tb = xd->tb;
+
+	if (tb->cm_ops != &tb_cm_ops)
+		return -EOPNOTSUPP;
+	if (smp_load_acquire(&xd->native_dma_removed))
+		return -ENODEV;
+	if (!mutex_trylock(&tb->lock))
+		return -EAGAIN;
+	tb_release_native_paths(xd);
+	mutex_unlock(&tb->lock);
 	return 0;
 }
+EXPORT_SYMBOL_GPL(tb_xdomain_try_disable_native_paths);
 
+/**
+ * tb_service_try_native_properties_changed() - Publish without racing removal
+ * @svc: Native service whose local properties changed
+ *
+ * Serializes notification queueing with removal's stop_handshake. A plain
+ * flag check followed by tb_service_properties_changed() could enqueue work
+ * after removal canceled it. -EAGAIN requires retry; -ENODEV is terminal and
+ * queues nothing. Caller must not hold svc->lock. Existing API is unchanged.
+ */
+int tb_service_try_native_properties_changed(struct tb_service *svc)
+{
+	struct tb_xdomain *xd = tb_service_parent(svc);
+	struct tb *tb = xd->tb;
+	int ret = 0;
+
+	if (tb->cm_ops != &tb_cm_ops)
+		return -EOPNOTSUPP;
+	if (smp_load_acquire(&xd->native_dma_stopping))
+		return -ENODEV;
+	if (!mutex_trylock(&tb->lock))
+		return -EAGAIN;
+	if (xd->native_dma_stopping || xd->is_unplugged)
+		ret = -ENODEV;
+	else
+		tb_service_properties_changed(svc);
+	mutex_unlock(&tb->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(tb_service_try_native_properties_changed);
+
+void tb_xdomain_remove_native_paths(struct tb_xdomain *xd)
+{
+	if (xd->tb->cm_ops != &tb_cm_ops)
+		return;
+	/* Every software-CM XDomain removal funnels through here, BEFORE
+	 * stop_handshake, service unbind and cancel_delayed_work_sync. */
+	lockdep_assert_held(&xd->tb->lock);
+	smp_store_release(&xd->native_dma_stopping, true);
+	tb_release_native_paths(xd);
+	smp_store_release(&xd->native_dma_removed, true);
+}
+#endif
+
 /* hotplug handling */
 
 /*
@@ -2930,6 +3075,20 @@
 	tb_queue_hotplug(tb, route, pkg->port, pkg->unplug);
 }
 
+#if IS_ENABLED(CONFIG_INFINIBAND_STRIX_NHI)
+static void tb_stop_native_paths(struct tb_switch *sw)
+{
+	struct tb_port *port;
+
+	tb_switch_for_each_port(sw, port) {
+		if (tb_port_has_remote(port))
+			tb_stop_native_paths(port->remote->sw);
+		else if (port->xdomain)
+			tb_xdomain_remove_native_paths(port->xdomain);
+	}
+}
+#endif
+
 static void tb_stop(struct tb *tb)
 {
 	struct tb_cm *tcm = tb_priv(tb);
@@ -2937,6 +3096,11 @@
 	struct tb_tunnel *n;
 
 	cancel_delayed_work(&tcm->remove_work);
+#if IS_ENABLED(CONFIG_INFINIBAND_STRIX_NHI)
+	/* Publish native admission shutdown and retire its exact tuples BEFORE
+	 * generic tunnel destruction and synchronous service removal. */
+	tb_stop_native_paths(tb->root_switch);
+#endif
 	/* tunnels are only present after everything has been initialized */
 	list_for_each_entry_safe(tunnel, n, &tcm->tunnel_list, list) {
 		/*
@@ -2948,6 +3112,10 @@
 			tb_tunnel_deactivate(tunnel);
 		tb_tunnel_put(tunnel);
 	}
+	/* Native XDomain removal below may look for its exact tuple. All
+	 * tunnels above are deactivated/released: never traverse freed nodes. */
+	if (IS_ENABLED(CONFIG_INFINIBAND_STRIX_NHI))
+		INIT_LIST_HEAD(&tcm->tunnel_list);
 	tb_switch_remove(tb->root_switch);
 	tcm->hotplug_active = false; /* signal tb_handle_hotplug to quit */
 }
