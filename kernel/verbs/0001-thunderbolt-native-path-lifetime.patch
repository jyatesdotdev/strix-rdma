+static int tb_approve_xdomain_paths(struct tb *tb, struct tb_xdomain *xd,
+		int transmit_path, int transmit_ring, int receive_path, int receive_ring)
+{
+	int ret;
 
+	mutex_lock(&tb->lock);
+	ret = __tb_approve_xdomain_paths(tb, xd, transmit_path, transmit_ring,
+				       receive_path, receive_ring);
