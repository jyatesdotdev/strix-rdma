@@ -1265,6 +1265,11 @@ struct tb_xdomain *tb_xdomain_alloc(struct tb *tb, struct device *parent,
 void tb_xdomain_add(struct tb_xdomain *xd);
 void tb_xdomain_remove(struct tb_xdomain *xd);
 void tb_xdomain_unregister(struct tb_xdomain *xd);
+#if IS_ENABLED(CONFIG_INFINIBAND_STRIX_NHI)
+void tb_xdomain_remove_native_paths(struct tb_xdomain *xd);
+#else
+static inline void tb_xdomain_remove_native_paths(struct tb_xdomain *xd) { }
+#endif
 struct tb_xdomain *tb_xdomain_find_by_link_depth(struct tb *tb, u8 link,
 						 u8 depth);
 
diff --git a/drivers/thunderbolt/xdomain.c b/drivers/thunderbolt/xdomain.c
index 86b2f7474..7a92cf535 100644
--- a/drivers/thunderbolt/xdomain.c
+++ b/drivers/thunderbolt/xdomain.c
@@ -2223,6 +2223,10 @@ static int unregister_service(struct device *dev, void *data)
  */
 void tb_xdomain_remove(struct tb_xdomain *xd)
 {
+	/* Software-CM callers hold tb->lock, including domain stop, scan,
+	 * unplug and resume cleanup. Retire native paths before any callback
+	 * or cancel_sync can wait for a service worker. ICM is a no-op here. */
+	tb_xdomain_remove_native_paths(xd);
 	tb_xdomain_debugfs_remove(xd);
 
 	mutex_lock(&xd->lock);
diff --git a/include/linux/thunderbolt.h b/include/linux/thunderbolt.h
index a9ecfbe8b..0c1324183 100644
--- a/include/linux/thunderbolt.h
+++ b/include/linux/thunderbolt.h
@@ -284,6 +284,14 @@ struct tb_xdomain {
 	atomic_t ntunnels;
 	u8 link;
 	u8 depth;
+#if IS_ENABLED(CONFIG_INFINIBAND_STRIX_NHI)
+	/* Native service tuple is owned under tb->lock until exact cleanup.
+	 * native_dma_removed is release/acquire published after core cleanup. */
+	int native_tx_path[2], native_tx_ring[2], native_rx_path[2], native_rx_ring[2];
+	unsigned int native_dma_count;
+	bool native_dma_stopping;
+	bool native_dma_removed;
+#endif
 };
 
 int tb_xdomain_lane_bonding_enable(struct tb_xdomain *xd);
@@ -299,6 +307,12 @@ int tb_xdomain_disable_paths(struct tb_xdomain *xd, int transmit_path,
 			     int transmit_ring, int receive_path,
