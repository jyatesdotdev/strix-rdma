+/**
+ * struct tbstream_zc_counters - Monotonic counters for one zero-copy session
+ * @tx_submit_calls: TX submit attempts
+ * @tx_submit_frames: TX frames requested
+ * @tx_callbacks: Non-canceled TX frame callbacks
+ * @tx_terminal_callbacks: Message-ending TX callbacks
+ * @tx_events: TX completion events queued
+ * @tx_enqueue_errors: TX enqueue failures
+ * @rx_callbacks: Non-canceled RX frame callbacks
+ * @rx_data_more: Continuation RX callbacks
+ * @rx_data: Message-ending DATA RX callbacks
+ * @rx_close: CLOSE RX callbacks
+ * @rx_events: RX or CLOSE events queued
+ * @rx_repost_calls: RX repost attempts
+ * @rx_repost_frames: RX frames requested for repost
+ * @rx_repost_errors: RX enqueue failures during repost
+ * @reap_calls: Event reap attempts
+ * @reaped_events: Events copied and dequeued
+ * @event_drops: Events that could not be queued
+ * @crc_errors: RX CRC errors
+ * @overrun_errors: RX buffer overruns
+ * @canceled_callbacks: Ring callbacks canceled during shutdown
+ * @failures: Transitions into terminal zero-copy failure
+ */
+struct tbstream_zc_counters {
+	u64 tx_submit_calls;
+	u64 tx_submit_frames;
+	u64 tx_callbacks;
+	u64 tx_terminal_callbacks;
+	u64 tx_events;
+	u64 tx_enqueue_errors;
+	u64 rx_callbacks;
+	u64 rx_data_more;
+	u64 rx_data;
+	u64 rx_close;
+	u64 rx_events;
+	u64 rx_repost_calls;
+	u64 rx_repost_frames;
+	u64 rx_repost_errors;
+	u64 reap_calls;
+	u64 reaped_events;
+	u64 event_drops;
+	u64 crc_errors;
+	u64 overrun_errors;
+	u64 canceled_callbacks;
+	u64 failures;
+};
