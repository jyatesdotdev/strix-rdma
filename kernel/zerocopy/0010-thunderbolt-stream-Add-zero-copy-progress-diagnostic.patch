+static int tbstream_dev_zc_kick(struct tbstream_dev *sdev, void __user *arg)
+{
+	struct tbstream_zc_kick kick;
+	int ret = 0;
+
+	if (!zc_diagnostic_kick)
+		return -EACCES;
+	if (!capable(CAP_SYS_RAWIO))
+		return -EPERM;
+	if (copy_from_user(&kick, arg, sizeof(kick)))
+		return -EFAULT;
+	if (!kick.rings ||
+	    (kick.rings & ~(TBSTREAM_ZC_KICK_TX | TBSTREAM_ZC_KICK_RX)) ||
+	    kick.reserved)
+		return -EINVAL;
+
+	if (mutex_lock_interruptible(&sdev->lock))
+		return -ERESTARTSYS;
+	ret = tbstream_dev_valid(sdev);
+	if (ret || tbstream_dev_removed(sdev)) {
+		ret = -ENXIO;
+		goto out_unlock;
+	}
+	if (!sdev->zc || !sdev->tx_ring.ring || !sdev->rx_ring.ring) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	if (kick.rings & TBSTREAM_ZC_KICK_RX) {
+		int rx_ret = tb_ring_kick(sdev->rx_ring.ring);
+
+		if (!ret)
+			ret = rx_ret;
+	}
+	if (kick.rings & TBSTREAM_ZC_KICK_TX) {
+		int tx_ret = tb_ring_kick(sdev->tx_ring.ring);
+
+		if (!ret)
+			ret = tx_ret;
+	}
+
+out_unlock:
+	mutex_unlock(&sdev->lock);
+	return ret;
+}
