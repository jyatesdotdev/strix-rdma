+static void
+tbstream_dev_zc_copy_ring_stats(struct tbstream_zc_ring_stats *dst,
+				const struct tb_ring_stats *src)
+{
+	dst->descriptors_posted = src->descriptors_posted;
+	dst->descriptors_completed = src->descriptors_completed;
+	dst->interrupts = src->interrupts;
+	dst->work_runs = src->work_runs;
+	dst->kick_requests = src->kick_requests;
+	dst->kick_pending = src->kick_pending;
+	if (src->is_tx)
+		dst->flags |= TBSTREAM_ZC_RING_F_TX;
+	if (src->running)
+		dst->flags |= TBSTREAM_ZC_RING_F_RUNNING;
+	if (src->irq > 0)
+		dst->flags |= TBSTREAM_ZC_RING_F_MSIX;
+	if (src->interrupt_enabled)
+		dst->flags |= TBSTREAM_ZC_RING_F_INTERRUPT_ENABLED;
+	if (src->tail_flags & RING_DESC_COMPLETED)
+		dst->flags |= TBSTREAM_ZC_RING_F_TAIL_COMPLETED;
+	if (src->hw_valid)
+		dst->flags |= TBSTREAM_ZC_RING_F_HW_VALID;
+	dst->hop = src->hop;
+	dst->irq = src->irq;
+	dst->vector = src->vector;
+	dst->size = src->size;
+	dst->sw_head = src->head;
+	dst->sw_tail = src->tail;
+	dst->hw_posted = src->hw_posted;
+	dst->hw_completed = src->hw_completed;
+	dst->queued = src->queued;
+	dst->in_flight = src->in_flight;
+	dst->tail_flags = src->tail_flags;
+	dst->tail_length = src->tail_length;
+	dst->tail_eof = src->tail_eof;
+	dst->tail_sof = src->tail_sof;
+	dst->options = src->options;
+	dst->interval_nsec = src->interval_nsec;
+}
