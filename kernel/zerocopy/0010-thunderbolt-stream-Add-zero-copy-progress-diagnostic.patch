+	if (!sdev->zc || !sdev->tx_ring.ring || !sdev->rx_ring.ring) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	spin_lock_irqsave(&sdev->zc_lock, flags);
+	stats.tx_submit_calls = c->tx_submit_calls;
+	stats.tx_submit_frames = c->tx_submit_frames;
+	stats.tx_callbacks = c->tx_callbacks;
+	stats.tx_terminal_callbacks = c->tx_terminal_callbacks;
+	stats.tx_events = c->tx_events;
+	stats.tx_enqueue_errors = c->tx_enqueue_errors;
+	stats.rx_callbacks = c->rx_callbacks;
+	stats.rx_data_more = c->rx_data_more;
+	stats.rx_data = c->rx_data;
+	stats.rx_close = c->rx_close;
+	stats.rx_events = c->rx_events;
+	stats.rx_repost_calls = c->rx_repost_calls;
+	stats.rx_repost_frames = c->rx_repost_frames;
+	stats.rx_repost_errors = c->rx_repost_errors;
+	stats.reap_calls = c->reap_calls;
+	stats.reaped_events = c->reaped_events;
+	stats.event_drops = c->event_drops;
+	stats.crc_errors = c->crc_errors;
+	stats.overrun_errors = c->overrun_errors;
+	stats.canceled_callbacks = c->canceled_callbacks;
+	stats.failures = c->failures;
+	stats.tx_prod = sdev->tx_ring.prod;
+	stats.tx_cons = sdev->tx_ring.cons;
+	stats.rx_prod = sdev->rx_ring.prod;
+	stats.rx_cons = sdev->rx_ring.cons;
+	stats.tx_pending = sdev->zc_tx_pending;
+	stats.tx_done = sdev->zc_tx_done;
+	stats.rx_partial_frames = sdev->zc_rx_msg_frames;
+	stats.rx_partial_bytes = sdev->zc_rx_msg_bytes;
+	stats.fifo_len = kfifo_len(&sdev->zc_events);
+	stats.fifo_avail = kfifo_avail(&sdev->zc_events);
+	if (sdev->zc_failed)
+		stats.flags |= TBSTREAM_ZC_STATS_F_FAILED;
+	if (sdev->closed)
+		stats.flags |= TBSTREAM_ZC_STATS_F_CLOSED;
+	stats.last_error = sdev->zc_last_error;
+	spin_unlock_irqrestore(&sdev->zc_lock, flags);
+
+	if (tbstream_dev_removed(sdev))
+		stats.flags |= TBSTREAM_ZC_STATS_F_REMOVED;
+	stats.in_hopid = sdev->in_hopid;
+	stats.out_hopid = sdev->out_hopid;
+	stats.throttling = sdev->throttling;
+
+	ret = tb_ring_get_stats(sdev->tx_ring.ring, &tx);
+	if (ret)
+		goto out_unlock;
+	ret = tb_ring_get_stats(sdev->rx_ring.ring, &rx);
+	if (ret)
+		goto out_unlock;
+	tbstream_dev_zc_copy_ring_stats(&stats.tx, &tx);
+	tbstream_dev_zc_copy_ring_stats(&stats.rx, &rx);
+
+	mutex_unlock(&sdev->lock);
+	return copy_to_user(arg, &stats, sizeof(stats)) ? -EFAULT : 0;
+
+out_unlock:
+	mutex_unlock(&sdev->lock);
+	return ret;
+}
