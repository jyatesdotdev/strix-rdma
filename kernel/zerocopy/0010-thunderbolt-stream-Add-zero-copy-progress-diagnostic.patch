+/**
+ * tb_ring_get_stats() - Snapshot diagnostic ring progress
+ * @ring: Ring to snapshot
+ * @stats: Destination for the snapshot
+ *
+ * The snapshot holds the NHI lock followed by the ring lock, matching the
+ * interrupt path. It deliberately avoids the clear-on-read notification
+ * registers.
+ *
+ * Return: %0 on success, %-EINVAL for an invalid destination.
+ */
+int tb_ring_get_stats(struct tb_ring *ring, struct tb_ring_stats *stats)
+{
+	struct ring_desc *descriptor;
+	unsigned long flags;
+	u32 index, indices;
+	int interrupt;
+	int pm_ret;
+
+	if (!stats)
+		return -EINVAL;
+
+	memset(stats, 0, sizeof(*stats));
+	pm_ret = pm_runtime_get_if_active(&ring->nhi->pdev->dev);
+	spin_lock_irqsave(&ring->nhi->lock, flags);
+	spin_lock(&ring->lock);
+
+	stats->descriptors_posted = ring->descriptors_posted;
+	stats->descriptors_completed = ring->descriptors_completed;
+	stats->interrupts = ring->interrupts;
+	stats->work_runs = ring->work_runs;
+	stats->kick_requests = ring->kick_requests;
+	stats->kick_pending = ring->kick_pending;
+	stats->size = ring->size;
+	stats->hop = ring->hop;
+	stats->head = ring->head;
+	stats->tail = ring->tail;
+	stats->queued = ring_list_count(&ring->queue);
+	stats->in_flight = ring_list_count(&ring->in_flight);
+	stats->interval_nsec = ring->interval_nsec;
+	stats->irq = ring->irq;
+	stats->vector = ring->vector;
+	stats->is_tx = ring->is_tx;
+	stats->running = ring->running;
+
+	if (!ring_empty(ring)) {
+		descriptor = &ring->descriptors[ring->tail];
+		stats->tail_flags = descriptor->flags;
+		if (stats->tail_flags & RING_DESC_COMPLETED)
+			dma_rmb();
+		stats->tail_length = descriptor->length;
+		stats->tail_eof = descriptor->eof;
+		stats->tail_sof = descriptor->sof;
+	}
+
+	if (pm_ret > 0 && ring->running && !ring->nhi->going_away) {
+		indices = ioread32(ring_desc_base(ring) + 8);
+		if (ring->is_tx) {
+			stats->hw_posted = indices >> 16;
+			stats->hw_completed = indices & GENMASK(15, 0);
+		} else {
+			stats->hw_posted = indices & GENMASK(15, 0);
+			stats->hw_completed = indices >> 16;
+		}
+		stats->options = ioread32(ring_options_base(ring));
+
+		interrupt = ring_interrupt_index(ring);
+		index = REG_RING_INTERRUPT_BASE + interrupt / 32 * 4;
+		stats->interrupt_enabled =
+			ioread32(ring->nhi->iobase + index) & BIT(interrupt % 32);
+		stats->hw_valid = true;
+	}
+
+	spin_unlock(&ring->lock);
+	spin_unlock_irqrestore(&ring->nhi->lock, flags);
+	if (pm_ret > 0)
+		pm_runtime_put_noidle(&ring->nhi->pdev->dev);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(tb_ring_get_stats);
+
+/**
+ * tb_ring_kick() - Explicitly schedule normal ring completion work
+ * @ring: Ring whose work should be scheduled
+ *
+ * This diagnostic helper does not modify descriptors or interrupt state.
+ *
+ * Return: %0 when the running ring was kicked, %-ENODEV if the NHI is being
+ * removed, or %-ESHUTDOWN if the ring is stopped.
+ */
+int tb_ring_kick(struct tb_ring *ring)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&ring->nhi->lock, flags);
+	spin_lock(&ring->lock);
+	if (ring->nhi->going_away) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+	if (!ring->running) {
+		ret = -ESHUTDOWN;
+		goto out_unlock;
+	}
+
+	ring->kick_requests++;
+	if (!ring_empty(ring) &&
+	    ring->descriptors[ring->tail].flags & RING_DESC_COMPLETED)
+		ring->kick_pending++;
+	schedule_work(&ring->work);
+
+out_unlock:
+	spin_unlock(&ring->lock);
+	spin_unlock_irqrestore(&ring->nhi->lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(tb_ring_kick);
+
 /**
  * nhi_mailbox_cmd() - Send a command through NHI mailbox
  * @nhi: Pointer to the NHI structure
@@ -1014,6 +1147,7 @@ static void nhi_interrupt_work(struct work_struct *work)
 		}
 
 		spin_lock(&ring->lock);
+		ring->interrupts++;
 		__ring_interrupt(ring);
 		spin_unlock(&ring->lock);
 	}
