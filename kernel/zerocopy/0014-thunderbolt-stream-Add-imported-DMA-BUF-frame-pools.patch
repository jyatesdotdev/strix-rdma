@@ -667,6 +701,14 @@ static int tbstream_dev_alloc_rx_buffers(struct tbstream_dev *sdev)
 		struct tbstream_frame *sf = &sdev->rx_ring.frames[i];
 		dma_addr_t dma_addr;
 
+		if (sdev->zc_rx_import) {
+			sf->sdev = sdev;
+			sf->frame.callback = tbstream_dev_rx_callback;
