@@ -611,9 +641,10 @@ tbstream_dev_completed_rx(struct tbstream_dev *sdev)
 	if (!sf->completed)
 		return NULL;
 
-	dma_sync_single_for_cpu(dma_dev, sf->frame.buffer_phy,
-				tb_ring_frame_size(&sf->frame),
