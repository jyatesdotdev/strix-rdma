-		if (sf->frame.buffer_phy)
+		/* Imported frames carry DMA-BUF addresses the pool does not own. */
+		if (sf->page && sf->frame.buffer_phy)
 			dma_unmap_page(dma_dev, sf->frame.buffer_phy,
 				       TB_MAX_FRAME_SIZE, dir);
 		sf->frame.buffer_phy = 0;
@@ -490,9 +519,10 @@ tbstream_dev_zc_rx(struct tbstream_dev *sdev, struct tbstream_frame *sf)
 	bool wake_error = false;
