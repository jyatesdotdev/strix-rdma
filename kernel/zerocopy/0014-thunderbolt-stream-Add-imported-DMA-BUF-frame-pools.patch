-	if (zc) {
+	if (zc && sf->page) {
 		struct device *dma_dev = tb_ring_dma_device(ring);
 
 		dma_sync_single_for_cpu(dma_dev, sf->frame.buffer_phy,
@@ -785,6 +827,14 @@ static int tbstream_dev_alloc_tx_buffers(struct tbstream_dev *sdev)
 		struct tbstream_frame *sf = &sdev->tx_ring.frames[i];
 		dma_addr_t dma_addr;
 
+		if (sdev->zc_tx_import) {
+			sf->sdev = sdev;
+			sf->frame.callback = tbstream_dev_tx_callback;
+			sf->frame.buffer_phy = sdev->zc_tx_import->iovas[i];
+			sf->frame.sof = TBSTREAM_FRAME_START;
+			continue;
+		}
+
 		sf->page = alloc_page(GFP_KERNEL);
 		if (!sf->page)
 			return -ENOMEM;
@@ -852,10 +902,79 @@ tbstream_dev_send_data(struct tbstream_dev *sdev, struct iov_iter *from,
 	return tb_ring_tx(sdev->tx_ring.ring, &sf->frame);
 }
 
+static void
+tbstream_dev_close_frame_callback(struct tb_ring *ring,
+				  struct ring_frame *frame, bool canceled)
+{
+	/*
+	 * The dedicated CLOSE frame is not part of the slot pool, so its
+	 * completion must not touch pool cursors or zero-copy state.
+	 */
+}
+
+/*
+ * An imported TX pool has no CPU mapping the kernel could write a
+ * CLOSE packet into, so imported-TX sessions carry one dedicated
+ * page-backed control frame outside the slot pool.
+ */
+static int tbstream_dev_alloc_close_frame(struct tbstream_dev *sdev)
+{
+	struct device *dma_dev = tb_ring_dma_device(sdev->tx_ring.ring);
+	struct tbstream_frame *sf = &sdev->zc_close_frame;
+	dma_addr_t dma_addr;
+
+	sf->page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	if (!sf->page)
+		return -ENOMEM;
+
+	dma_addr = dma_map_page(dma_dev, sf->page, 0, TB_MAX_FRAME_SIZE,
+				DMA_TO_DEVICE);
+	if (dma_mapping_error(dma_dev, dma_addr)) {
+		__free_page(sf->page);
+		sf->page = NULL;
+		return -ENOMEM;
+	}
+
+	sf->sdev = sdev;
+	sf->frame.callback = tbstream_dev_close_frame_callback;
+	sf->frame.buffer_phy = dma_addr;
+	sf->frame.sof = TBSTREAM_FRAME_START;
+	sdev->zc_close_frame_mapped = true;
+	return 0;
+}
+
+/* Safe to call only while the TX ring is still allocated. */
+static void tbstream_dev_free_close_frame(struct tbstream_dev *sdev)
+{
+	struct tbstream_frame *sf = &sdev->zc_close_frame;
+	struct device *dma_dev;
+
+	if (!sdev->zc_close_frame_mapped)
+		return;
+
+	dma_dev = tb_ring_dma_device(sdev->tx_ring.ring);
+	dma_unmap_page(dma_dev, sf->frame.buffer_phy, TB_MAX_FRAME_SIZE,
+		       DMA_TO_DEVICE);
+	__free_page(sf->page);
+	memset(sf, 0, sizeof(*sf));
+	sdev->zc_close_frame_mapped = false;
+}
+
 static int tbstream_dev_send_close(struct tbstream_dev *sdev)
 {
 	struct tbstream_frame *sf;
 
+	if (sdev->zc_tx_import) {
+		sf = &sdev->zc_close_frame;
+
+		if (!sdev->zc_close_frame_mapped)
+			return -ENXIO;
+		sf->frame.size = SZ_256;
+		sf->frame.eof = TBSTREAM_CLOSE;
+		sf->frame.flags = 0;
+		return tb_ring_tx(sdev->tx_ring.ring, &sf->frame);
+	}
+
 	sf = tbstream_dev_alloc_tx(sdev, TBSTREAM_CLOSE, NULL, SZ_256);
 	if (IS_ERR(sf))
 		return PTR_ERR(sf);
@@ -879,6 +998,12 @@ static int tbstream_dev_start(struct tbstream_dev *sdev)
 	if (ret)
 		goto err_free_tx_buffers;
 
+	if (sdev->zc_tx_import) {
+		ret = tbstream_dev_alloc_close_frame(sdev);
+		if (ret)
+			goto err_free_tx_buffers;
+	}
+
 	e2e_tx_hop = ring->hop;
 	sof_mask = BIT(TBSTREAM_FRAME_START);
 	eof_mask = BIT(TBSTREAM_DATA) | BIT(TBSTREAM_CLOSE) |
@@ -925,6 +1050,7 @@ static int tbstream_dev_start(struct tbstream_dev *sdev)
 	tb_ring_free(sdev->rx_ring.ring);
 	sdev->rx_ring.ring = NULL;
 err_free_tx_buffers:
+	tbstream_dev_free_close_frame(sdev);
 	tbstream_ring_free(&sdev->tx_ring);
 	tb_ring_free(sdev->tx_ring.ring);
 	sdev->tx_ring.ring = NULL;
@@ -972,6 +1098,7 @@ static void tbstream_dev_stop(struct tbstream_dev *sdev)
 	tbstream_ring_free(&sdev->rx_ring);
 	tb_ring_free(sdev->rx_ring.ring);
 	sdev->rx_ring.ring = NULL;
+	tbstream_dev_free_close_frame(sdev);
 	tbstream_ring_free(&sdev->tx_ring);
 	tb_ring_free(sdev->tx_ring.ring);
 	sdev->tx_ring.ring = NULL;
@@ -982,6 +1109,32 @@ static void tbstream_dev_stop(struct tbstream_dev *sdev)
 	}
 }
 
+/*
+ * Rings and DMA paths are activated lazily by the first operation that
+ * needs them, so a DMA-BUF pool import can precede path activation and
+ * receive descriptors are always primed before the peer can transmit.
+ * sdev->lock must be held.
+ */
+static int tbstream_dev_activate_locked(struct tbstream_dev *sdev)
+{
+	int ret;
+
+	if (sdev->started)
+		return 0;
+	if (!sdev->users || tbstream_dev_removed(sdev))
+		return -ENXIO;
+	ret = tbstream_dev_valid(sdev);
+	if (ret)
+		return ret;
+
+	ret = tbstream_dev_start(sdev);
+	if (ret)
+		return ret;
+	sdev->started = true;
+	sdev->closed = false;
+	return 0;
+}
+
 static ssize_t
 tbstream_dev_fops_read_iter(struct kiocb *kiocb, struct iov_iter *to)
 {
@@ -998,10 +1151,13 @@ tbstream_dev_fops_read_iter(struct kiocb *kiocb, struct iov_iter *to)
 
 	if (mutex_lock_interruptible(&sdev->lock))
 		return -ERESTARTSYS;
-	if (sdev->zc) {
+	if (sdev->zc || sdev->zc_tx_import || sdev->zc_rx_import) {
 		ret = -EBUSY;
 		goto out_unlock;
 	}
+	ret = tbstream_dev_activate_locked(sdev);
+	if (ret)
+		goto out_unlock;
 
 	while (!tbstream_ring_available(&sdev->rx_ring)) {
 		mutex_unlock(&sdev->lock);
@@ -1101,10 +1257,13 @@ tbstream_dev_fops_write_iter(struct kiocb *kiocb, struct iov_iter *from)
 
 	if (mutex_lock_interruptible(&sdev->lock))
 		return -ERESTARTSYS;
-	if (sdev->zc) {
+	if (sdev->zc || sdev->zc_tx_import || sdev->zc_rx_import) {
 		ret = -EBUSY;
 		goto out_unlock;
 	}
+	ret = tbstream_dev_activate_locked(sdev);
+	if (ret)
+		goto out_unlock;
 
 	while (!tbstream_ring_available(&sdev->tx_ring)) {
 		mutex_unlock(&sdev->lock);
@@ -1170,6 +1329,17 @@ tbstream_dev_fops_poll(struct file *file, struct poll_table_struct *wait)
 	guard(mutex)(&sdev->lock);
 	if (tbstream_dev_valid(sdev) != 0 || tbstream_dev_removed(sdev)) {
 		mask |= EPOLLHUP | EPOLLERR;
+	} else if (!sdev->started) {
+		/*
+		 * An imported device activates only through
+		 * TBSTREAM_ZC_ENABLE; nothing is ready before that.
+		 */
+		if (!sdev->zc_tx_import && !sdev->zc_rx_import) {
+			if (tbstream_dev_activate_locked(sdev))
+				mask |= EPOLLHUP | EPOLLERR;
+			else if (tbstream_ring_available(&sdev->tx_ring))
+				mask |= EPOLLOUT | EPOLLWRNORM;
+		}
 	} else if (sdev->zc) {
 		bool failed = tbstream_dev_zc_failed(sdev);
 
@@ -1207,7 +1377,7 @@ static int tbstream_dev_zc_enable(struct tbstream_dev *sdev)
 	if (ret)
 		goto out_unlock;
 
-	if (!sdev->users || !sdev->tx_ring.ring) {
+	if (!sdev->users) {
 		ret = -ENXIO;
 		goto out_unlock;
 	}
@@ -1218,6 +1388,10 @@ static int tbstream_dev_zc_enable(struct tbstream_dev *sdev)
 	if (sdev->zc)
 		goto out_unlock;
 
+	ret = tbstream_dev_activate_locked(sdev);
+	if (ret)
+		goto out_unlock;
+
 	size = tb_ring_size(sdev->tx_ring.ring);
 	spin_lock_irqsave(&sdev->zc_lock, flags);
 	if (sdev->tx_ring.prod - sdev->tx_ring.cons != size - 1) {
@@ -1245,8 +1419,10 @@ static int tbstream_dev_zc_enable(struct tbstream_dev *sdev)
 	for (i = 0; i < size; i++) {
 		struct tbstream_frame *sf = &sdev->tx_ring.frames[i];
 
-		dma_sync_single_for_cpu(dma_dev, sf->frame.buffer_phy,
-					TB_MAX_FRAME_SIZE, DMA_TO_DEVICE);
+		if (sf->page)
+			dma_sync_single_for_cpu(dma_dev, sf->frame.buffer_phy,
+						TB_MAX_FRAME_SIZE,
+						DMA_TO_DEVICE);
 	}
 
 	spin_lock_irqsave(&sdev->zc_lock, flags);
@@ -1255,6 +1431,8 @@ static int tbstream_dev_zc_enable(struct tbstream_dev *sdev)
 		for (i = 0; i < size; i++) {
 			struct tbstream_frame *sf = &sdev->tx_ring.frames[i];
 
+			if (!sf->page)
+				continue;
 			dma_sync_single_for_device(dma_dev,
 						   sf->frame.buffer_phy,
 						   TB_MAX_FRAME_SIZE,
@@ -1655,6 +1833,10 @@ static int tbstream_dev_zc_get_stats(struct tbstream_dev *sdev,
 
 	if (tbstream_dev_removed(sdev))
 		stats.flags |= TBSTREAM_ZC_STATS_F_REMOVED;
+	if (sdev->zc_tx_import)
+		stats.flags |= TBSTREAM_ZC_STATS_F_TX_IMPORTED;
+	if (sdev->zc_rx_import)
+		stats.flags |= TBSTREAM_ZC_STATS_F_RX_IMPORTED;
 	stats.in_hopid = sdev->in_hopid;
 	stats.out_hopid = sdev->out_hopid;
 	stats.throttling = sdev->throttling;
@@ -1809,10 +1991,13 @@ static int tbstream_dev_zc_dmabuf_probe(struct tbstream_dev *sdev,
 		ret = -ENXIO;
 		goto out_unlock;
 	}
-	if (sdev->zc || !sdev->tx_ring.ring || !sdev->rx_ring.ring) {
+	if (sdev->zc || sdev->zc_tx_import || sdev->zc_rx_import) {
 		ret = -EINVAL;
 		goto out_unlock;
 	}
+	ret = tbstream_dev_activate_locked(sdev);
+	if (ret)
+		goto out_unlock;
 	dma_dev = tb_ring_dma_device(dir == DMA_TO_DEVICE ?
 				     sdev->tx_ring.ring : sdev->rx_ring.ring);
 
@@ -1882,6 +2067,216 @@ static int tbstream_dev_zc_dmabuf_probe(struct tbstream_dev *sdev,
 	return ret;
 }
 
+static void
+tbstream_dev_zc_import_half_release(struct tbstream_zc_import_half *half,
+				    enum dma_data_direction dir)
+{
+	if (!half)
+		return;
+	kvfree(half->iovas);
+	dma_buf_unmap_attachment(half->attach, half->sgt, dir);
+	dma_buf_unpin(half->attach);
+	dma_buf_detach(half->dmabuf, half->attach);
+	dma_buf_put(half->dmabuf);
+	kfree(half);
+}
+
+/* sdev->lock must be held and the rings must not be running. */
+static void tbstream_dev_zc_import_release(struct tbstream_dev *sdev)
+{
+	tbstream_dev_zc_import_half_release(sdev->zc_tx_import, DMA_TO_DEVICE);
+	sdev->zc_tx_import = NULL;
+	tbstream_dev_zc_import_half_release(sdev->zc_rx_import,
+					    DMA_FROM_DEVICE);
+	sdev->zc_rx_import = NULL;
+}
+
+/*
+ * Import one directional pool. Every acquired object is released in
+ * reverse order on any failure, leaving the device unchanged.
+ */
+static struct tbstream_zc_import_half *
+tbstream_dev_zc_import_half(struct tbstream_dev *sdev,
+			    const struct tbstream_zc_import_range *range,
+			    enum dma_data_direction dir, u64 pool_bytes,
+			    struct device *dma_dev)
+{
+	struct tbstream_zc_import_half *half;
+	struct tbstream_sg_query query;
+	int ret;
+
+	if (range->flags)
+		return ERR_PTR(-EINVAL);
+	if (!IS_ALIGNED(range->offset, TBSTREAM_ZC_FRAME_SIZE) ||
+	    range->length != pool_bytes)
+		return ERR_PTR(-EINVAL);
+
+	half = kzalloc_obj(*half);
+	if (!half)
+		return ERR_PTR(-ENOMEM);
+
+	half->dmabuf = dma_buf_get(range->fd);
+	if (IS_ERR(half->dmabuf)) {
+		ret = PTR_ERR(half->dmabuf);
+		goto err_free;
+	}
+	/* RX hardware writes the buffer; reject a read-only object. */
+	if (dir == DMA_FROM_DEVICE &&
+	    !(half->dmabuf->file->f_mode & FMODE_WRITE)) {
+		ret = -EBADF;
+		goto err_put;
+	}
+	if (range->offset > half->dmabuf->size ||
+	    range->length > half->dmabuf->size - range->offset) {
+		ret = -EINVAL;
+		goto err_put;
+	}
+
+	half->attach = dma_buf_dynamic_attach(half->dmabuf, dma_dev,
+					      &tbstream_dmabuf_attach_ops,
+					      NULL);
+	if (IS_ERR(half->attach)) {
+		ret = PTR_ERR(half->attach);
+		goto err_put;
+	}
+
+	ret = dma_buf_pin(half->attach);
+	if (ret)
+		goto err_detach;
+
+	half->sgt = dma_buf_map_attachment(half->attach, dir);
+	if (IS_ERR(half->sgt)) {
+		ret = PTR_ERR(half->sgt);
+		goto err_unpin;
+	}
+
+	half->iovas = kvcalloc(sdev->ring_size, sizeof(*half->iovas),
+			       GFP_KERNEL);
+	if (!half->iovas) {
+		ret = -ENOMEM;
+		goto err_unmap;
+	}
+
+	ret = tbstream_sg_flatten(half->sgt, range->offset, range->length,
+				  half->iovas, sdev->ring_size, &query);
+	if (ret)
+		goto err_free_iovas;
+	if (query.covered != range->length ||
+	    query.frames != sdev->ring_size) {
+		ret = -EINVAL;
+		goto err_free_iovas;
+	}
+	return half;
+
+err_free_iovas:
+	kvfree(half->iovas);
+err_unmap:
+	dma_buf_unmap_attachment(half->attach, half->sgt, dir);
+err_unpin:
+	dma_buf_unpin(half->attach);
+err_detach:
+	dma_buf_detach(half->dmabuf, half->attach);
+err_put:
+	dma_buf_put(half->dmabuf);
+err_free:
+	kfree(half);
+	return ERR_PTR(ret);
+}
+
+/*
+ * Atomically select DMA-BUF backed frame pools for the zero-copy
+ * session a following TBSTREAM_ZC_ENABLE will start. Must run on an
+ * exclusively opened, never-activated device so no path can carry
+ * traffic into or out of a partially configured pool.
+ */
+static int tbstream_dev_zc_import(struct tbstream_dev *sdev,
+				  void __user *arg)
+{
