 MODULE_PARM_DESC(zc_diagnostic_dmabuf,
-		 "allow privileged DMA-BUF import probe diagnostics");
+		 "allow privileged DMA-BUF import diagnostics (probe and pool import)");
 
 static_assert(sizeof(struct tbstream_zc_ring_stats) == 128);
 static_assert(sizeof(struct tbstream_zc_stats) == 528);
 static_assert(offsetof(struct tbstream_zc_stats, tx) == 272);
 static_assert(sizeof(struct tbstream_zc_dmabuf_probe) == 96);
+static_assert(sizeof(struct tbstream_zc_import_range) == 24);
+static_assert(sizeof(struct tbstream_zc_import) == 88);
 static_assert(offsetof(struct tbstream_zc_stats, rx) == 400);
 static_assert(sizeof(struct tbstream_zc_kick) == 8);
 
@@ -132,6 +134,27 @@ struct tbstream_frame {
 	struct ring_frame frame;
 };
 
+/**
+ * struct tbstream_zc_import_half - One imported directional frame pool
+ * @dmabuf: Imported DMA-BUF; owns a file reference independent of the
+ *	userspace fd
+ * @attach: Attachment to the NHI DMA device
+ * @sgt: DMA-mapped SG table, pinned for the life of the import
+ * @iovas: One frame-aligned DMA address per pool slot (ring_size
+ *	entries), flattened from @sgt
+ *
+ * Imported frames have no CPU page: the payload owner is the exporting
+ * device, so no dma_sync_single_*() calls are valid on these
+ * addresses. Ownership is transferred through hardware completion and
+ * the exporter's own synchronization primitives.
+ */
+struct tbstream_zc_import_half {
+	struct dma_buf *dmabuf;
+	struct dma_buf_attachment *attach;
+	struct sg_table *sgt;
+	u64 *iovas;
+};
+
 /**
  * struct tbstream_ring - Stream RX/TX ring structure
  * @ring: Pointer to the API ring
@@ -228,9 +251,14 @@ struct tbstream_dev {
