From a48b0ee1f331cca5982f025b4a65841abbc1d070 Mon Sep 17 00:00:00 2001
From: Jonathan Yates <me@jyates.dev>
Date: Mon, 24 Aug 2026 17:00:46 -0700
Subject: [PATCH] thunderbolt: stream: Skip CLOSE toward an already-closed peer

When the peer has already sent its CLOSE, its receive path is being
torn down and no longer returns E2E credits, so a CLOSE posted at
release can never complete: it sits in the TX ring until the teardown
flush times out, printing a warning that looks like a hardware stall
but is expected close ordering. Skip the CLOSE in that case; the peer
already considers the link closed.

Also ratelimit the flush timeout warning. A peer that goes away without
its CLOSE reaching us (or userspace re-creating connection generations
against a dead peer) produces one uncompletable CLOSE per generation,
observed as 78 warnings at two-second cadence over five minutes while a
DS4 coordinator outlived its worker.
---
 drivers/thunderbolt/stream.c | 44 ++++++++++++++++++++++++------------
 1 file changed, 29 insertions(+), 15 deletions(-)

diff --git a/drivers/thunderbolt/stream.c b/drivers/thunderbolt/stream.c
index efb8d743e..17b15b9eb 100644
--- a/drivers/thunderbolt/stream.c
+++ b/drivers/thunderbolt/stream.c
@@ -1067,14 +1067,21 @@ static void tbstream_dev_stop(struct tbstream_dev *sdev)
 	/* Wait for the ring to complete any outstanding frames */
 	if (!tb_ring_flush(sdev->tx_ring.ring, 500)) {
 		tb_ring_get_stats(sdev->tx_ring.ring, &stats);
-		pr_warn("device %d TX ring %d flush timed out: hw-valid=%u sw-head=%u sw-tail=%u hw-posted-index=%u hw-completed-index=%u queued=%u in-flight=%u posted-count=%llu completed-count=%llu irq-count=%llu work-count=%llu\n",
-			sdev->index, stats.hop, stats.hw_valid, stats.head,
-			stats.tail, stats.hw_posted, stats.hw_completed,
-			stats.queued, stats.in_flight,
-			(unsigned long long)stats.descriptors_posted,
-			(unsigned long long)stats.descriptors_completed,
-			(unsigned long long)stats.interrupts,
-			(unsigned long long)stats.work_runs);
+		/*
+		 * Ratelimited: a peer that went away without its CLOSE
+		 * reaching us leaves frames that can never complete, and
+		 * userspace connection churn would otherwise flood the log
+		 * with one warning per generation.
+		 */
+		pr_warn_ratelimited("device %d TX ring %d flush timed out: hw-valid=%u sw-head=%u sw-tail=%u hw-posted-index=%u hw-completed-index=%u queued=%u in-flight=%u posted-count=%llu completed-count=%llu irq-count=%llu work-count=%llu\n",
+				    sdev->index, stats.hop, stats.hw_valid,
+				    stats.head, stats.tail, stats.hw_posted,
+				    stats.hw_completed, stats.queued,
+				    stats.in_flight,
+				    (unsigned long long)stats.descriptors_posted,
+				    (unsigned long long)stats.descriptors_completed,
+				    (unsigned long long)stats.interrupts,
+				    (unsigned long long)stats.work_runs);
 	}
 	tb_ring_stop(sdev->tx_ring.ring);
 	/*
@@ -2442,14 +2449,21 @@ static int tbstream_dev_fops_release(struct inode *inode, struct file *file)
 			 * Send CLOSE tunneled packet to notify the other
 			 * end that we are closing the file. We do this
 			 * twice if the first one fails.
+			 *
+			 * A peer that already sent CLOSE is tearing down
+			 * or gone: its receive path no longer returns E2E
+			 * credits, so our CLOSE could never complete and
+			 * would only stall the teardown flush below.
 			 */
-			ret = tbstream_dev_send_close(sdev);
-			if (ret) {
-				int retry = tbstream_dev_send_close(sdev);
-
-				if (retry)
-					pr_warn("device %d failed to send CLOSE twice: %d, %d\n",
-						sdev->index, ret, retry);
+			if (!sdev->closed) {
+				ret = tbstream_dev_send_close(sdev);
+				if (ret) {
+					int retry = tbstream_dev_send_close(sdev);
+
+					if (retry)
+						pr_warn("device %d failed to send CLOSE twice: %d, %d\n",
+							sdev->index, ret, retry);
+				}
 			}
 			tbstream_dev_stop(sdev);
 			sdev->started = false;
-- 
2.55.0

