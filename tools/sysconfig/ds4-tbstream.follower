# Install as /etc/sysconfig/ds4-tbstream on the other endpoint (max).
TBSTREAM_ROLE=follower
TBSTREAM_NAME=ds4
TBSTREAM_RING_SIZE=4096
TBSTREAM_THROTTLING=0
# Validate the local pair learned from the allocator. For an asymmetric pair,
# these values must reverse the allocator's OUT/IN values respectively.
TBSTREAM_IN_HOPID=9
TBSTREAM_OUT_HOPID=9
# Reserve thunderbolt-net's HopIDs before attaching the stream pair at boot.
# Leave empty only on a link that intentionally has no Thunderbolt netdev.
TBSTREAM_NETDEV=thunderbolt0
TBSTREAM_WAIT_SECONDS=90
TBSTREAM_HOLDER_WAIT_SECONDS=30
TBSTREAM_DEVICE_WAIT_SECONDS=10
TBSTREAM_GROUP=tbstream
