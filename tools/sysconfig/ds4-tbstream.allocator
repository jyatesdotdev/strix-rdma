# Install as /etc/sysconfig/ds4-tbstream on exactly one endpoint (max2).
TBSTREAM_ROLE=allocator
TBSTREAM_NAME=ds4
TBSTREAM_RING_SIZE=4096
TBSTREAM_THROTTLING=0
# Pin the local pair after thunderbolt-net has reserved HopID 8. Exact
# allocation failure is fatal for this reconcile pass; there is no fallback.
TBSTREAM_IN_HOPID=9
TBSTREAM_OUT_HOPID=9
# Reserve thunderbolt-net's HopIDs before allocating the stream pair at boot.
# Leave empty only on a link that intentionally has no Thunderbolt netdev.
TBSTREAM_NETDEV=thunderbolt0
TBSTREAM_WAIT_SECONDS=90
TBSTREAM_HOLDER_WAIT_SECONDS=30
TBSTREAM_DEVICE_WAIT_SECONDS=10
TBSTREAM_GROUP=tbstream
